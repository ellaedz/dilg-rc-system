APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

AI_INFERENCE_URL=http://127.0.0.1:9000
AI_INFERENCE_CONNECT_TIMEOUT=3
AI_INFERENCE_TIMEOUT=20
AI_INFERENCE_LEASE_SECONDS=60
AI_INFERENCE_MAX_RESPONSE_BYTES=262144
REPORT_PHOTO_LOCAL_ROOT=
REPORT_PHOTO_QUARANTINE_LOCAL_ROOT=
REPORT_TRACKING_TOKEN_DERIVATION_KEY=
REPORT_TRACKING_TOKEN_LOOKUP_KEY=
REPORT_IDEMPOTENCY_HMAC_KEY=
REPORT_PHOTO_DISK=report_photos
REPORT_PHOTO_QUARANTINE_DISK=report_photo_quarantine
REPORT_PHOTO_MAX_BYTES=5242880
REPORT_PHOTO_MAX_WIDTH=8000
REPORT_PHOTO_MAX_HEIGHT=8000
REPORT_PHOTO_MAX_PIXELS=20000000
REPORT_PHOTO_JPEG_QUALITY=85
REPORT_PHOTO_PNG_COMPRESSION=6
REPORT_PHOTO_PROCESSING_LEASE_SECONDS=300
REPORT_PHOTO_QUARANTINE_ENABLED=false
REPORT_PHOTO_QUARANTINE_TTL_HOURS=24
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Keep empty during Phase 9A so a hidden URL cannot override individual safeguards.
DB_URL=
# DB_HOST=your-approved-session-pooler-host
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=your-dedicated-laravel-role
# DB_PASSWORD=
# DB_SCHEMA=civiclear
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=C:/absolute/path/outside-the-repository/prod-ca-2021.crt
# DB_APPLICATION_NAME=civiclear-laravel

# Disposable Phase 9A PostgreSQL validation only. Never use civiclear, public,
# auth, storage, extensions, graphql_public, or realtime as this schema.
# PHASE9A_DB_HOST=your-approved-session-pooler-host
# PHASE9A_DB_PORT=5432
# PHASE9A_DB_DATABASE=postgres
# PHASE9A_DB_USERNAME=your-migration-admin-role
# PHASE9A_DB_PASSWORD=
# PHASE9A_DB_SCHEMA=civiclear_phase9a_test_unique_suffix
# PHASE9A_DB_SSLMODE=verify-full
# PHASE9A_DB_SSLROOTCERT=C:/absolute/path/outside-the-repository/prod-ca-2021.crt
# PHASE9A_EXPECTED_DATABASE=postgres
# Leave unset until the user separately approves the frozen backup and final import gate.
# PHASE9A_FINAL_IMPORT_APPROVED=
# Final import currently supports the explicit value "preserve" only.
# PHASE9A_OPERATIONAL_TABLE_POLICY=
# Temporary Gate 2 protection. Keep true until PostgreSQL writes are separately approved.
# PHASE9A_RUNTIME_READ_ONLY=false
# Leave unset except during the separately approved Gate 3A validation process.
# PHASE9A_WRITE_VALIDATION_APPROVED=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006
